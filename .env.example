# Copy to .env and fill in. .env is git-ignored and excluded from the Docker image.

# --- LLM and MCP tool keys ---------------------------------------------------
GROQ_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
AVIATION_STACK_API_KEY=

# --- Docker Compose only -----------------------------------------------------
# Use a URL-safe password (letters and digits): it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=
# POSTGRES_USER=tripmate
# POSTGRES_DB=tripmate
# APP_PORT=8000

# --- Running WITHOUT Docker ----------------------------------------------------
# PostgreSQL is required (LangGraph checkpoints). Example for a local server:
# DATABASE_URL=postgresql://user:password@localhost:5432/tripmate?sslmode=disable
# Redis is optional. When REDIS_URL is unset, weather caching is simply off.
# REDIS_URL=redis://localhost:6379/0

# --- Optional tuning (defaults shown) ------------------------------------------
# WEATHER_CACHE_TTL_SECONDS=3600
# MCP_TIMEOUT_SECONDS=60
# LLM_TIMEOUT_SECONDS=60
# MAX_QUERY_CHARS=2000
# LOG_LEVEL=INFO

# --- Optional LangSmith tracing ------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tripmate-ai
